# ---------------------------------------------------------------------------
# Legendary Card Games - root .gitignore
# ---------------------------------------------------------------------------

# --- Copyrighted Upper Deck material (fetch locally, never commit) ----------
# Card art scraped from legendarycardgame.com  -> predator/scripts/download_cards.py
predator/assets/
predator/source/
predator/download_log.txt
# Official rulebook / card list PDFs (download from Upper Deck, see README)
predator/*.pdf
# Verbatim rulebook text extracted from the PDF -> tools/rules/extract_rules_text.py
predator/data/rules_extracted.json

# --- Generated outputs ------------------------------------------------------
# Print-and-play PDFs / previews  -> predator/scripts/generate_*.py
predator/output/
# Offline quantity reviewer        -> predator/scripts/generate_reviewer_html.py
predator/review.html

# --- Native game (game/) ----------------------------------------------------
# CMake / Ninja / vcpkg build tree
game/build/
game/out/
# Runtime assets generated by tools/build_assets.py (board, card textures, layout)
game/assets/
# Runtime movement / verification logs
game/logs/
logs/

# --- Archived React prototype (archive/app-react) ---------------------------
archive/app-react/node_modules/
archive/app-react/dist/
# Junction to predator/assets (recreate locally, see README)
archive/app-react/public/assets
# Thumbnails generated by scripts/build-catalog.mjs from the card art
archive/app-react/public/thumbs/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Editors / OS -----------------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
Thumbs.db
Desktop.ini
.DS_Store

# --- Secrets ----------------------------------------------------------------
.env
.env.*
